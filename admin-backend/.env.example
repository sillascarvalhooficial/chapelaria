# Copie este arquivo pra ".env" e preencha com valores reais.
# ".env" nunca deve ser commitado — só este exemplo.

PORT=5700

# Gere um valor novo e aleatório pra cada instalação, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Usados só na primeira vez que o servidor roda (criação do usuário admin).
# Depois disso, trocar aqui não muda a senha — use a seção 6 do painel pra isso.
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha

# Senha mestre — só o Sillas sabe. Usada na tela de login ("Esqueci minha senha")
# pra redefinir a senha do cliente sem precisar da senha atual (caso ele esqueça).
# Use a MESMA senha mestre em todos os projetos, assim só precisa lembrar de uma.
MASTER_RESET_PASSWORD=troque-por-uma-senha-mestre-forte

# Use "production" quando publicar com HTTPS de verdade.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Banco de dados (Turso / libSQL) — deixe as duas linhas abaixo em branco pra
# rodar localmente com um arquivo (igual antes, sem precisar de conta).
# Pra publicar de graça (ex: Render, que não tem disco persistente), crie uma
# conta grátis em https://turso.tech (sem cartão), crie um banco e cole aqui:
#   turso db create atelie-chapeu
#   turso db show atelie-chapeu --url          -> TURSO_DATABASE_URL
#   turso db tokens create atelie-chapeu       -> TURSO_AUTH_TOKEN
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Imagens (Cloudinary) — necessário pra upload de fotos funcionar (achados e
# antes/depois). Crie uma conta grátis em https://cloudinary.com (sem cartão)
# e copie os 3 valores do "Product Environment Credentials" do dashboard.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
